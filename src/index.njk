---
title: The Naxal Archive
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/Project-Aurora/assets/css/style.css">
</head>
<body>
  <header>
    <h1>The Naxal Archive</h1>
    <p>Documenting spatial dynamics, data, and analysis.</p>
  </header>

  <section style="max-width: 800px; margin: 40px auto; padding: 0 20px;">
    <h2>Latest Field Reports &amp; Analysis</h2>
    <ul>
      {% for post in collections.articles %}
        <li>
          <a href="{{ post.url | url }}">{{ post.data.title }}</a> 
          <small>({{ post.data.date | date: "%b %d, %Y" }})</small>
        </li>
      {% endfor %}
    </ul>
  </section>
</body>
</html>
